import json
import os
import subprocess
import urllib.request

# Gate mode runs no Tailscale node; the gate and Host edge own the network.
if os.environ.get("PASEO_NETWORK_MODE", "tailscale") != "gate":
    status = subprocess.run(
        ["/usr/local/bin/tailscale", "--socket=/run/tailscale/tailscaled.sock", "status", "--json"],
        capture_output=True, text=True, timeout=5,
    )
    state = json.loads(status.stdout).get("BackendState")
    if state != "Running":
        raise SystemExit("Tailscale requires administrator attention: " + str(state))
with urllib.request.urlopen("http://127.0.0.1:6767/", timeout=3) as response:
    if response.status != 200:
        raise SystemExit("Vorteo web listener is unavailable")
