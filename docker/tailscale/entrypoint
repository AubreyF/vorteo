#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
unset BASH_ENV ENV PYTHONPATH PYTHONHOME
umask 077
if [[ -z "${PASEO_PASSWORD:-}" || "$PASEO_PASSWORD" == replace-* ]]; then
  echo 'Set a generated PASEO_PASSWORD before starting this container.' >&2
  exit 1
fi
install -d -m 0700 /var/lib/tailscale /run/tailscale /run/personal-tailscale
# Gate mode: the installation gate is this environment's only network path,
# so no Tailscale node runs here and SSH tunnels through the gate.
case "${PASEO_NETWORK_MODE:-tailscale}" in
  tailscale) export PASEO_TAILSCALE_AUTOSTART=true ;;
  gate)
    export PASEO_TAILSCALE_AUTOSTART=false
    # The agent user must read this; the entrypoint's umask is 077.
    printf 'Host *\n  ProxyCommand /usr/local/bin/gate-connect %%h %%p\n' > /etc/ssh/ssh_config.d/gate.conf
    chmod 0644 /etc/ssh/ssh_config.d/gate.conf
    ;;
  *) echo 'PASEO_NETWORK_MODE must be tailscale or gate.' >&2; exit 1 ;;
esac
# Initialize only an empty disposable home. Never recursively change owner data.
if ! /usr/bin/setpriv --reuid=paseo --regid=paseo --clear-groups \
  --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs \
  /usr/bin/test -d /home/paseo/.paseo; then
  # Root has CHOWN but no DAC_OVERRIDE. Linux bind mounts retain the Host's
  # private mode, so create children as their owner after assigning the root.
  chown paseo:paseo /home/paseo
  /usr/bin/setpriv --reuid=paseo --regid=paseo --clear-groups \
    --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs \
    /usr/bin/install -d -m 0700 /home/paseo/.paseo
fi
# A new instance owns an empty workspace. Never change an existing project's ownership.
if [[ -d /workspace ]]; then
  # Inspect as the current owner: root cannot read a private Host-owned mount.
  # A failed inspection must not be mistaken for an empty workspace.
  workspace_entry="$(/usr/bin/setpriv \
    --reuid="$(stat -c %u /workspace)" --regid="$(stat -c %g /workspace)" --clear-groups \
    --bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs \
    find /workspace -mindepth 1 -maxdepth 1 -print -quit)"
  if [[ -z "$workspace_entry" ]]; then chown paseo:paseo /workspace; fi
fi
exec /usr/bin/supervisord -n -c /etc/personal-tailscale/supervisord.conf
